{
  "expo": {
    "name": "donx",
    "slug": "donx",
    "owner": "donkezz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "donx",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.donkezz.donxtrade",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "DonX"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-localization",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to sort listings by distance and to place your listing on the map.",
          "locationAlwaysAndWhenInUsePermission": "Your location is used to sort listings by distance and to place your listing on the map.",
          "locationAlwaysPermission": "Your location is used to sort listings by distance and to place your listing on the map.",
          "motionUsagePermission": "DonX does not use motion data."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo access lets you add pictures and videos to your listing.",
          "cameraPermission": "The camera lets you take a photo for your listing.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ea7e778-3d71-426b-802f-e775af86feda"
      }
    },
    "locales": {
      "sk": "./src/i18n/native/sk.json",
      "en": "./src/i18n/native/en.json",
      "pl": "./src/i18n/native/pl.json",
      "hu": "./src/i18n/native/hu.json",
      "uk": "./src/i18n/native/uk.json",
      "de": "./src/i18n/native/de.json"
    }
  }
}
